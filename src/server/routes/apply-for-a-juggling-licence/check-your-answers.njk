{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "How many balls can you juggle?" },
            value: { text: howManyBalls },
            actions: {
              items: [
                { href: "/juggling-balls", text: "Change", visuallyHiddenText: "how many balls you can juggle" }
              ]
            }
          },
          {
            key: { text: "What is your most impressive juggling trick?" },
            value: { text: mostImpressiveTrick },
            actions: {
              items: [
                { href: "/juggling-trick", text: "Change", visuallyHiddenText: "your most impressive juggling trick" }
              ]
            }
          }
        ]
      }) }}

      <form method="post">
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukButton({ text: "Confirm and submit" }) }}
      </form>
    </div>
  </div>
{% endblock %}
