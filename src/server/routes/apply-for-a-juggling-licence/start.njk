{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "Apply for a juggling licence"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body">Use this service to apply for a licence to juggle 3 or more balls in a public place.</p>
      <p class="govuk-body">It usually takes about 5 minutes to complete.</p>

      {{ govukButton({
        text: "Start now",
        href: "/juggling-balls",
        isStartButton: true
      }) }}
    </div>
  </div>
{% endblock %}
