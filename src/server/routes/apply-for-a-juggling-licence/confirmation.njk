{% extends 'layouts/page.njk' %}

{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: t("journey:confirmation.title"),
        html: t("journey:confirmation.reference") + "<br><strong>" + referenceNumber + "</strong>"
      }) }}

      <p class="govuk-body">{{ t("journey:confirmation.email") }}</p>
      <p class="govuk-body">
        <a class="govuk-link" href="/">{{ t("journey:confirmation.return") }}</a>
      </p>
    </div>
  </div>
{% endblock %}
