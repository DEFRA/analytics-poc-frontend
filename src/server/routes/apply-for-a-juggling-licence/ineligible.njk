{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: pageTitle,
    caption: "Apply for a juggling licence"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body">You need to be able to juggle 3 or more balls to apply for a juggling licence.</p>
      <p class="govuk-body">You can return to this service when you are able to juggle 3 or more balls.</p>
      <p class="govuk-body">
        <a class="govuk-link" href="/apply-for-a-juggling-licence">Return to the start page</a>
      </p>
    </div>
  </div>
{% endblock %}
